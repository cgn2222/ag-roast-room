# OPTIONAL. The default mode needs no file and no key: your agent (Google Antigravity or
# Claude Code) runs the council and the room only plays it. Nothing below is read unless
# COUNCIL_RUNNER=api. Never commit .env (it is in .gitignore).
#
# COST WARNING: the API runner makes about 25 model calls per full council and bills the
# account that owns the key. A full council sends each seat's whole brain (~35 KB) every call.

# "viewer" (default, free) or "api" (the room runs councils itself, billed to your key)
COUNCIL_RUNNER=viewer

# Which provider the API runner uses: anthropic (default) | gemini | mock (offline, free, fake text for testing)
LLM_PROVIDER=anthropic

# --- provider: anthropic -------------------------------------------------------------
# https://console.anthropic.com/settings/keys  (defaults: seats claude-sonnet-5-5, chair claude-opus-5-5)
ANTHROPIC_API_KEY=

# --- provider: gemini ----------------------------------------------------------------
# https://aistudio.google.com/apikey  Billed to your Google AI account.
# You MUST also set SEAT_MODEL and CHAIR_MODEL to Gemini model ids you have access to
# (the app does not guess them). Not validated against the live API in this repo's tests.
GEMINI_API_KEY=

# Override the model ids for any provider (required for gemini)
SEAT_MODEL=
CHAIR_MODEL=
